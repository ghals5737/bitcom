# EC2 에서 backend/.env 로 복사해 값 채우기. run.sh 가 --env-file 로 컨테이너에 주입한다.
DB_URL=jdbc:postgresql://<rds-host>:5432/bitcom
DB_USER=
DB_PASSWORD=
BACKGROUND_URL=https://54capvm12g.execute-api.ap-northeast-2.amazonaws.com

# Cloudflare Pages(HTTPS) 뒤에서 Secure 쿠키 사용
COOKIE_SECURE=true

# 제출용 계정 비밀번호 (비우면 application.yml 기본값)
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
