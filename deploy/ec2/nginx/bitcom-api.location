# /etc/nginx/snippets/bitcom-api.location
# 이미 실행 중인 server 블록 안에 한 줄 추가:  include /etc/nginx/snippets/bitcom-api.location;
# /bitcom/api/ 요청만 백엔드 컨테이너(127.0.0.1:8000)로 넘긴다. 나머지 경로는 기존 설정 그대로.
location /bitcom/api/ {
    proxy_pass http://bitcom_backend;      # 경로 그대로 전달 (/bitcom/api/... 유지)
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    # 외부 Background Check API 가 최대 ~35s 걸릴 수 있어 여유 있게
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    client_max_body_size 1m;
}
